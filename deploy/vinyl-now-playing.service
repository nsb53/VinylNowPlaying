[Unit]
Description=Vinyl Now Playing
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi-master
WorkingDirectory=/home/pi-master/VinylNowPlaying
EnvironmentFile=/home/pi-master/VinylNowPlaying/pi.env
ExecStart=/home/pi-master/VinylNowPlaying/.venv/bin/python tools/now_playing_server.py --host 0.0.0.0 --audio-backend alsa --alsa-device ${ALSA_DEVICE} --alsa-rate 48000 --level-window 0.25
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
