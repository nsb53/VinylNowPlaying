# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key.

# Google Gemini API key, used for song info (original release, songwriters,
# genre) and trivia. Get one at https://aistudio.google.com/apikey
# If left empty, the dashboard still runs with Shazam-only metadata and no trivia.
GEMINI_API_KEY=
